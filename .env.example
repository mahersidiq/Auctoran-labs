# Copy to .env and configure before accepting any real orders.
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Checkout uses demo mode when STRIPE_SECRET_KEY is empty.
# Use sk_test_... to test Stripe Checkout. Never put this secret in client JS.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to true only when product prices/catalog/policies/stock/shipping/tax are finalized.
STORE_LIVE=false
# Example: SHIP_US_CENTS=0 for free US shipping. Must be set before STORE_LIVE=true.
SHIP_US_CENTS=
# If Stripe Tax has been configured, optional:
STRIPE_AUTOMATIC_TAX=false

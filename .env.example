# Copy to .env for local use. On a host (Render, Railway, Fly), set these in its dashboard instead.
PORT=3000
# Your public https:// address. Required for Stripe redirects. (Set automatically on Render.)
PUBLIC_BASE_URL=http://localhost:3000

# --- Payments (Stripe) ---
# Empty = demo mode (no payment). sk_test_... = Stripe test mode. sk_live_... = real payments.
STRIPE_SECRET_KEY=
# From Stripe Dashboard > Developers > Webhooks, endpoint https://YOUR-DOMAIN/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Turn on only when ready to sell. Live checkout stays closed until every required setting below is present.
STORE_LIVE=false
# US shipping fee in cents, e.g. 695 = $6.95, 0 = free. Required for live.
SHIP_US_CENTS=
# Optional: free shipping at or above this subtotal in cents, e.g. 7500 = $75.
FREE_SHIP_OVER_CENTS=
# true only after Stripe Tax is set up in your Stripe account.
STRIPE_AUTOMATIC_TAX=false

# --- Store operations ---
# Shown on the contact and policy pages. Required for live.
SUPPORT_EMAIL=
# Long random password for the /admin orders page. Generate one: node -e "console.log(crypto.randomUUID())"
ADMIN_TOKEN=
# Optional: URL that receives a POST for every paid order (Slack incoming webhook, Zapier, Make...).
ORDER_NOTIFY_URL=
# Where orders.json is written. On Render, point this at the persistent disk.
DATA_DIR=storage
# true when running behind a hosting proxy (Render, Railway, Fly, Heroku) so rate limits are per customer.
TRUST_PROXY=false
